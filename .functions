#!/usr/bin/env zsh

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

json_echo() {
# prettify json content
  printf '%s\n' "$1" | jq '.' --tab | bat --color=always -l json
}


prettify_json() {
# Pretty-print JSON files with proper indentation and save to specified folder
# Usage: prettify_json "output_folder"
# Examples:
#   prettify_json "formatted"     # Creates 'formatted' folder with prettified JSON files
# Note: Processes all files in current directory, creates output folder if needed
  local output_dir=$1

  if [[ ! -d $output_dir ]]; then
    echo "Creating folder $output_dir"
    mkdir -p "$output_dir"
  fi
  for file in *; do
    [[ -f $file ]] && jq '.' --tab < "$file" > "$output_dir/$file"
  done
}


rename_files() {
# Remove specified characters from all filenames in current directory
# Usage: rename_files "char1" "char2" "char3" ...
# Examples:
#   rename_files " "           # Remove spaces
#   rename_files " " "_"       # Remove spaces and underscores
#   rename_files "(" ")" "[" "]"  # Remove brackets/parentheses
# Requires: rename command installed

  echo "Renaming files removing the following characters $@ with rename"
  for c in "$@"; do
    rename "'$c'" '' *
  done
}

ask() {
  local reply
  while true; do
    printf "Existing %s/%s, should be replaced? ([y]/n) " "$INSTALL_FOLDER" "$DEST"
    IFS= read -r reply
    reply=${reply:-"y"}
    if [[ $reply == [Yy] ]]; then
      return 0
    elif [[ $reply == [Nn] ]]; then
      return 1
    fi
  done

}
# functions
dl_and_mv_repo(){
    local URL=$1              # url to zip file with the master branch of the repository
    local ZIP=$2              # name of the zip and unziped folder ex.: dot-file-main.zip and dot-file-main
    local DEST=$3             # name of the destination folder
    local DOWNLOAD_FOLDER=$4  # path to the download folder
    local INSTALL_FOLDER=$5   # path to be installed

    if [[ -d "$INSTALL_FOLDER/$DEST" ]]; then
      ask || { echo "Exiting..." && return 1; }
    fi
    echo ""
    [[ -e "$DOWNLOAD_FOLDER/$ZIP.zip" ]] && rm "$DOWNLOAD_FOLDER/$ZIP.zip"
    echo "Download $URL waiting for it under $DOWNLOAD_FOLDER with filename: $ZIP.zip"
    xdg-open $URL
    while ! [[ -e "$DOWNLOAD_FOLDER/$ZIP.zip" ]];do sleep 1; done
    echo ""
    cd "$DOWNLOAD_FOLDER" || return 1
    { [[ -e $DOWNLOAD_FOLDER/$ZIP.zip ]] && sleep 2 } || { echo "$ZIP.zip file not found. Exiting"; exit 1; }
    unzip -qq "$ZIP.zip"
    [[ -d "$DOWNLOAD_FOLDER/$DEST" ]] && rm -r "$DOWNLOAD_FOLDER/$DEST"
    mv "$ZIP" "$DEST"
    [[ -d "$INSTALL_FOLDER/$DEST/.git" ]] && rm -rf "$INSTALL_FOLDER/$DEST/.git"
    [[ -d  "$INSTALL_FOLDER/$DEST" ]] && rm -r "$INSTALL_FOLDER/$DEST"
    mv "$DEST" "$INSTALL_FOLDER/"
    rm "$ZIP.zip"
    echo ""
}
export dl_and_mv_repo

# Function to install vim motions on jupyter
jupyter_vi_motion_extensions(){
  pip install jupyter_contrib_nbextensions
  mkdir -p "$(jupyter --data-dir)/nbextensions" || return 1
  cd "$(jupyter --data-dir)/nbextensions"
  git clone https://github.com/lambdalisue/jupyter-vim-binding vim_binding
  jupyter nbextension enable vim_binding/vim_binding
}

y() {
  # yazi wrapper: change the working directory to yazi's last location on exit
  local tmp cwd
  tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(cat -- "$tmp")" && [[ -n "$cwd" && "$cwd" != "$PWD" ]]; then
    builtin cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

git_list_stale_branches() {
  # list all stale branchs with more than 90 days unchanged
  local output_file=$1
  if [[ -z "$output_file" ]]; then
    echo "Expecting a filename in the ARG"
  fi

  git for-each-ref --sort=committerdate refs/remotes/ \
    --format="%(committerdate:short) %(refname:short)" | \
    awk -v cutoff="$(date -d '90 days ago' +%Y-%m-%d 2>/dev/null || date -v-90d +%Y-%m-%d 2>/dev/null)" \
    '$1 < cutoff' > "$output_file"
}

alias git-list-stale-branches='git_list_stale_branches'
