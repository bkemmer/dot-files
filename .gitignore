package/
**/.DS_Store
tmp.py
.local/*

# Claude Code runtime state lives in ~/.claude; only these are dotfiles-managed
.claude/*
!.claude/CLAUDE.md
!.claude/claude-powerline.json
!.claude/settings.json
!.claude/agents
!.claude/agents/**

# herdr runtime state lives in ~/.config/herdr; only config.toml is dotfiles-managed
.config/herdr/*
!.config/herdr/config.toml
