package/
**/.DS_Store
tmp.py
.local/*

# Claude Code runtime state lives in ~/.claude; only these are dotfiles-managed
.claude/*
!.claude/CLAUDE.md
!.claude/claude-powerline.json
!.claude/settings.json
!.claude/agents
!.claude/agents/**

# pi runtime state (auth.json, sessions) lives in ~/.pi/agent; only extensions are dotfiles-managed
.pi/agent/*
!.pi/agent/extensions
!.pi/agent/extensions/**

# herdr runtime state lives in ~/.config/herdr; only config.toml is dotfiles-managed
.config/herdr/*
!.config/herdr/config.toml
